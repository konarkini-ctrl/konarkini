---
import Layout from '../layouts/Layout.astro'; import Breadcrumb from './Breadcrumb.astro'; const { title, metaTitle, description, path, eyebrow='Good to know' } = Astro.props;
---
<Layout title={metaTitle} {description} {path}><div class="page-hero"><div class="container narrow"><Breadcrumb items={[{label:'Home',href:'/'},{label:title,href:path}]} /><p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p>{description}</p></div></div><article class="container prose"><slot /></article></Layout>
