---
import ProductBadge from './ProductBadge.astro'; const { product } = Astro.props;
---
<article class="product-card"><a class="product-image" href={`/products/${product.slug}/`} aria-label={`View ${product.name}`}><img src={product.image} alt={`${product.name} for ${product.age}`} width="540" height="640" loading="lazy" /><ProductBadge /></a><div class="product-copy"><p class="eyebrow">{product.age}</p><h3><a href={`/products/${product.slug}/`}>{product.name}</a></h3><p>{product.short}</p><strong>₹{product.price.toLocaleString('en-IN')}</strong></div></article>
