---
import Layout from '../layouts/Layout.astro'; import CategoryCard from '../components/CategoryCard.astro'; import ProductCard from '../components/ProductCard.astro'; import { categories, products } from '../data/products';
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Konarkini',
  url: 'https://konarkini.com',
  logo: 'https://konarkini.com/favicon.svg',
  description: 'Comfort-first clothing for children ages 0 to 5.',
  telephone: '+918520900901',
  email: 'konarkini@gmail.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Narayanapuram, Korramenugunta',
    addressLocality: 'Tirupati',
    addressRegion: 'Andhra Pradesh',
    postalCode: '517503',
    addressCountry: 'IN'
  }
};
---
<Layout title="Konarkini | Thoughtful Kids Clothing for Ages 0–5" description="Discover soft, comfortable clothing thoughtfully designed for babies and children from newborn to five years." path="/" schema={org}>
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">Comfort for every little chapter</p><h1>Clothes made for the magic of growing up.</h1><p>Soft fabrics, easy fits, and thoughtful details for tiny days, big discoveries, and everything in between.</p><div class="button-row"><a class="button" href="/shop/">Explore the collection</a><a class="text-link" href="/categories/">Shop by category →</a></div><div class="hero-notes"><span>♡ Gentle fabrics</span><span>◇ Ages 0–5</span><span>○ Easy everyday wear</span></div></div><div class="hero-visual"><div class="hero-blob"></div><img src="/images/brand-child.jpeg" alt="A cheerful child wearing a plum top and patterned bonnet" width="1080" height="1206" fetchpriority="high" /><div class="hero-sticker">Little clothes<br/><strong>Big comfort</strong></div></div></div></section>
<section class="section age-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Find their fit</p><h2>Shop by age</h2></div><p>Comfort that keeps up with every milestone.</p></div><div class="age-grid">{[['Newborn','0–6 months'],['Baby','6–24 months'],['Little kids','2–3 years'],['Growing kids','4–5 years']].map(([name,age],i)=><a href="/shop/" class={`age-card tone-${i}`}><span>{age}</span><strong>{name}</strong><span>Shop now →</span></a>)}</div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Made for their day</p><h2>Featured categories</h2></div><a class="text-link" href="/categories/">View all categories →</a></div><div class="category-grid">{categories.slice(0,6).map((category,i)=><CategoryCard {category} index={i}/>)}</div></div></section>
<section class="section product-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Parent-approved favourites</p><h2>Featured products</h2></div><a class="text-link" href="/shop/">Shop all →</a></div><div class="product-grid">{products.filter(p=>p.featured).map(product=><ProductCard {product}/>)}</div></div></section>
<section class="section new-section" id="new-arrivals"><div class="container split-feature"><div class="feature-image"><img src="/images/brand-child.jpeg" alt="Child in a comfortable everyday outfit" width="700" height="800" loading="lazy" /></div><div><p class="eyebrow">Just arrived</p><h2>Fresh little favourites</h2><p>New silhouettes and easy layers, made to feel soft from first wear to last adventure.</p><div class="mini-list">{products.filter(p=>p.isNew).slice(0,3).map(p=><a href={`/products/${p.slug}/`}><span>{p.name}<small>{p.age}</small></span><strong>₹{p.price.toLocaleString('en-IN')}</strong></a>)}</div><a class="button" href="/shop/#new-arrivals">See new arrivals</a></div></div></section>
<section class="section values"><div class="container"><div class="center-heading"><p class="eyebrow">Why Konarkini</p><h2>Small details, a world of difference</h2></div><div class="value-grid">{[['♡','Kind to little skin','Soft, breathable materials selected for everyday comfort.'],['◇','Made for movement','Easy silhouettes with room to crawl, climb, and explore.'],['○','Simple by design','Versatile pieces that make getting dressed feel effortless.'],['⌁','Thoughtful always','Considered details, clear information, and no unnecessary fuss.']].map(([icon,title,text])=><article><span>{icon}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
<section class="section brand-story"><div class="container story-grid"><div><p class="eyebrow">Our little story</p><h2>Childhood should feel comfortable.</h2><p>Konarkini began with a simple belief: little clothes should let children be entirely themselves. We create gentle everyday pieces for the first five years—considered, uncomplicated, and ready for real life.</p><a class="text-link" href="/about/">Meet the brand →</a></div><blockquote>“Soft enough for quiet moments. Free enough for big ones.”</blockquote></div></section>
<section class="newsletter"><div class="container newsletter-inner"><div><p class="eyebrow">A little note from us</p><h2>Join our growing circle</h2><p>Be first to hear about restocks, new pieces, and thoughtful stories.</p></div><form><label class="sr-only" for="email">Email address</label><input id="email" type="email" placeholder="Your email address" /><button type="button">Keep me posted</button></form></div></section>
</Layout>
