---
import Layout from '../layouts/Layout.astro'; import Breadcrumb from '../components/Breadcrumb.astro'; import ProductCard from '../components/ProductCard.astro'; import { products, categories } from '../data/products';
---
<Layout title="Shop Kids Clothing Ages 0–5 | Konarkini" description="Browse Konarkini clothing for newborns, babies, boys and girls aged two to five. All current styles are marked out of stock." path="/shop/"><div class="page-hero"><div class="container"><Breadcrumb items={[{label:'Home',href:'/'},{label:'Shop',href:'/shop/'}]} /><p class="eyebrow">The collection</p><h1>Clothes for little lives</h1><p>Everyday comfort for newborn days through age five.</p></div></div><section class="section"><div class="container"><div class="shop-toolbar"><p><strong>{products.length}</strong> thoughtful pieces</p><div class="filter-pills"><span>Browse:</span>{categories.slice(0,5).map(c=><a href={`?category=${c.slug}`}>{c.name}</a>)}</div></div><div class="product-grid shop-grid">{products.map(product=><ProductCard {product}/>)}</div></div></section></Layout>
